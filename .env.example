# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=development
# Use 127.0.0.1, not localhost: on Windows + Docker Desktop the IPv6 lookup can hang.
DATABASE_URL=postgresql+psycopg://legal:legal@127.0.0.1:5432/legal_ai
POSTGRES_PASSWORD=legal
# Host port published by docker compose; change it (and DATABASE_URL) if 5432 is taken.
POSTGRES_PORT=5432

# Auth. JWT_SECRET must be a random 32+ character value outside local development.
JWT_SECRET=dev-only-change-me
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Models.
#   hash / extractive  -> deterministic offline providers (no key, used by tests and the evaluation harness)
#   openai             -> semantic understanding + grounded generation (required in production)
# Switching EMBEDDING_PROVIDER or EMBEDDING_MODEL requires re-indexing approved versions.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
LLM_PROVIDER=extractive
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Source monitoring. Only allowlisted hosts may ever be fetched: the hosts below plus the code-reviewed
# hosts of the official source catalog (legal_core/source_catalog.py; set INCLUDE_CATALOG_HOSTS=false to
# allow only this list). Database rows can never add a host.
SOURCE_ALLOWLIST=laws.boe.gov.sa,www.uqn.gov.sa,uqn.gov.sa,www.hrsd.gov.sa,hrsd.gov.sa,mc.gov.sa,dgp.sdaia.gov.sa
INCLUDE_CATALOG_HOSTS=true
ALLOW_FIXTURE_SOURCES=false
MONITOR_INTERVAL_MINUTES=360
RESPECT_ROBOTS_TXT=true
FETCH_MIN_INTERVAL_SECONDS=1
# Politeness per connector run. Each catalog source has its own document limit per run (10 for the
# Bureau of Experts archive, 50 for the gazette feed); this is the global ceiling over all of them. The
# rest is fetched by the next nightly run (backlog). Known consolidated laws are re-read every N days
# to detect amendments.
CONNECTOR_MAX_ACQUISITIONS_PER_SOURCE=50
CONNECTOR_MAX_JUDGMENTS_PER_RUN=20
CONNECTOR_REFRESH_DAYS=7
CONNECTOR_MAX_REFRESHES_PER_SOURCE=5

# Autonomous nightly synchronization (PRD v2). Runs at 00:00 in SYNC_TIMEZONE; missed days inside
# SYNC_CATCHUP_DAYS are caught up and failed runs retried with exponential backoff.
SYNC_TIMEZONE=Asia/Riyadh
SYNC_HOUR=0
SYNC_MINUTE=0
SYNC_CATCHUP_DAYS=3
SYNC_MAX_RETRIES=3
SYNC_RETRY_BACKOFF_SECONDS=300
# rules (deterministic) | openai (structured proposal, still verified by the deterministic gate)
AGENT_PROVIDER=rules
# Optional Slack/Teams-compatible webhook for new-law, quarantine, outage and health alerts.
ALERT_WEBHOOK_URL=

# Scaling (see docs/scaling.md). Keep (pool + overflow) x WEB_CONCURRENCY x replicas < max_connections.
WEB_CONCURRENCY=2
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_PGBOUNCER=false
API_THREAD_LIMIT=100
# Number of reverse proxies in front of the API (Railway/nginx = 1). 0 = direct connections.
TRUSTED_PROXY_COUNT=0
RATE_LIMIT_BACKEND=database
RATE_LIMIT_CHAT_PER_MINUTE=20
ANSWER_CACHE_SIZE=2000
ANSWER_CACHE_TTL_SECONDS=900
MIN_LEXICAL_MATCHES=2
OFFICIAL_SERVICE_SEARCH_ENABLED=true
OFFICIAL_SERVICE_REFRESH_SECONDS=3600
OFFICIAL_SERVICE_CACHE_SECONDS=3600
OFFICIAL_SERVICE_TIMEOUT_SECONDS=25

# Privacy. Query text is not stored unless enabled; traces are purged after the retention period.
TRACE_STORE_QUERY_TEXT=false
TRACE_RETENTION_DAYS=30
